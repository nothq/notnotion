  "chip": {
    "dom": "span.notion-text-mention-token.notion-enable-hover.notion-focusable-token[contenteditable=false] > span(\"@\") + span.notion-reminder(label)",
    "color": "#7d7a75",
    "at_sign_color": "color-mix(in srgb, currentColor 60%, transparent)",
    "hover": ".notion-reminder.notion-enable-hover:hover { text-decoration: underline }",
    "cursor": "pointer",
    "font": "inherits block (16px / 24px)",
    "box": "no background, padding, border or radius",
    "measured_width_px": {"@Today": 57.9, "@Next Monday": 110.1, "@September 14, 2026": 162.2},
    "commit_inserts_trailing_space": true
