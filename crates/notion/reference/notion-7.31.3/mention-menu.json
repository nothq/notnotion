    ],
    "rules": {
      "keyword_prefix": "any prefix of today, tomorrow or yesterday resolves to that day; a shared prefix takes the earlier of the two (t is Today, not Tomorrow)",
      "weekday_prefix": "any prefix of a weekday name resolves inside the current Monday-start week, past or future (mon is 2026-08-31, fri is 2026-09-04, sun is 2026-09-06)",
      "month_name": "a bare month resolves to its first day; the year rolls forward only when the month is before the current month (sep is 2026-09-01, aug is 2027-08-01)",
      "date_row_sublabel": "the full date shows on the date row only when the query has no reminder row; a future date moves it to the reminder row instead",
      "ghost": "the completion of the first row's label, or of a person's name before the (You) suffix; absent when the label does not start with the query"
    }
  },
  "relative_label_rules": {
    "week_start": "Monday",
    "rules": [
      "same day: Today; +1: Tomorrow; -1: Yesterday",
      "same Monday-to-Sunday week: weekday name",
      "previous week: Last <weekday>; next week: Next <weekday>",
      "otherwise: <Month> <day>, <year> (year always shown)",
      "with time: label, space, h:mm AM/PM"
    ]
